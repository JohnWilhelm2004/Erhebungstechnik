recode = function(x) {
for (i in x) {
res = 6 - x[i]
x[i] = res
}
}
openness = bfi[, c("O1","O2", "O3", "O4", "O5")]
openness$O2 = recode(openness$O2)
openness$O5 = recode(openness$O5)
